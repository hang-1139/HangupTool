# ---------- 用户运行时数据 ----------
# 先忽略 data 下所有内容
hangup_tool/data/*
# 放行 lang 目录（翻译属于程序资源，要提交）
!hangup_tool/data/lang/
# 放行 tasks 目录本身，但忽略其内容，只保留 .gitkeep
!hangup_tool/data/tasks/
hangup_tool/data/tasks/*
!hangup_tool/data/tasks/.gitkeep

